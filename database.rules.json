{
  "rules": {
    "profiles": {
      ".read": true,
      ".write": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('profiles').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "deposits": {
      ".read": true,
      ".write": "auth != null"
    },
    "orders": {
      ".read": true,
      ".write": "auth != null"
    },
    "order_items": {
      ".read": true,
      ".write": "auth != null"
    },
    "provider_tasks": {
      ".read": true,
      ".write": "auth != null"
    },
    "wallet_addresses": {
      ".read": true,
      ".write": "auth != null"
    },
    "currencies": {
      ".read": true,
      ".write": "auth != null"
    },
    "networks": {
      ".read": true,
      ".write": "auth != null"
    },
    "transactions": {
      ".read": true,
      ".write": "auth != null"
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "support_tickets": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$ticket_id": {
        "ticket_messages": {
          "$msg_id": {
            ".validate": "newData.hasChildren(['user_id', 'message'])"
          }
        }
      }
    },
    "faqs": {
      ".read": true,
      ".write": "auth != null"
    },
    "testimonials": {
      ".read": true,
      ".write": "auth != null"
    },
    "admin_settings": {
      ".read": true,
      ".write": "auth != null"
    },
    "pricing_settings": {
      ".read": true,
      ".write": "auth != null"
    },
    "blog_posts": {
      ".read": true,
      ".write": "auth != null"
    },
    "site_content": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
