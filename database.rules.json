{
  "rules": {
    "profiles": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "deposits": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$deposit_id": {
        ".validate": "newData.hasChildren(['user_id', 'status'])",
        "user_id": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(pending|approved|rejected|timeout)$/) "
        },
        ".write": "auth != null && (root.child('profiles').child(auth.uid).child('role').val() === 'admin' || data.child('user_id').val() === auth.uid)"
      }
    },
    "orders": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$order_id": {
        ".validate": "newData.hasChildren(['user_id'])",
        "user_id": {
          ".validate": "newData.isString()"
        },
        ".write": "auth != null && (root.child('profiles').child(auth.uid).child('role').val() === 'admin' || root.child('profiles').child(auth.uid).child('role').val() === 'provider' || data.child('user_id').val() === auth.uid)"
      }
    },
    "support_tickets": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$ticket_id": {
        ".validate": "newData.hasChildren(['user_id'])",
        "user_id": {
          ".validate": "newData.isString()"
        },
        ".write": "auth != null && (root.child('profiles').child(auth.uid).child('role').val() === 'admin' || data.child('user_id').val() === auth.uid)",
        "messages": {
          "$msg_id": {
            ".validate": "newData.hasChildren(['sender_id', 'text'])",
            "sender_id": {
              ".validate": "newData.isString()"
            }
          }
        }
      }
    },
    "admin_settings": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin'"
    },
    "pricing_settings": {
      ".read": true,
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin'"
    },
    "currencies": {
      ".read": true,
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin'"
    },
    "networks": {
      ".read": true,
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin'"
    },
    "wallets": {
      ".read": true,
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin'"
    },
    "blog_posts": {
      ".read": true,
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin'"
    },
    "site_content": {
      ".read": true,
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin'"
    }
  }
}
